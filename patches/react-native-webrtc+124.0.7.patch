@@ -0,0 +1,61 @@
+#import "RTCPIPModule.h"
+#import "PIPController.h"
+
+/**
+ * Standalone native module for manual PiP control.
+ * Does NOT depend on the bridge or UIManager — works with both Paper and Fabric.
+ * Uses PIPController's static activeController reference.
+ */
+@implementation RTCPIPModule
+
+RCT_EXPORT_MODULE();
+
++ (BOOL)requiresMainQueueSetup {
+    return NO;
+}
+
+- (dispatch_queue_t)methodQueue {
+    return dispatch_get_main_queue();
+}
+
+RCT_EXPORT_METHOD(startPIP) {
+    @try {
+        if (@available(iOS 15.0, *)) {
+            PIPController *controller = [PIPController activeController];
+            if (controller) {
+                [controller startPIP];
+            } else {
+                NSLog(@"[RTCPIPModule] No active PIPController — cannot start PiP");
+            }
+        }
+    } @catch (NSException *e) {
+        RCTLogError(@"startPIP exception: %@", e);
+    }
+}
+
+RCT_EXPORT_METHOD(stopPIP) {
+    @try {
+        if (@available(iOS 15.0, *)) {
+            PIPController *controller = [PIPController activeController];
+            if (controller) {
+                [controller stopPIP];
+            } else {
+                NSLog(@"[RTCPIPModule] No active PIPController — cannot stop PiP");
+            }
+        }
+    } @catch (NSException *e) {
+        RCTLogError(@"stopPIP exception: %@", e);
+    }
+}
+
+RCT_EXPORT_METHOD(isActive:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject) {
+    if (@available(iOS 15.0, *)) {
+        PIPController *controller = [PIPController activeController];
+        BOOL active = controller && [controller isPictureInPictureActive];
+        resolve(@(active));
+    } else {
+        resolve(@(NO));
+    }
+}
+
+@end
