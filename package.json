{
  "name": "camstack",
  "main": "index.js",
  "version": "1.0.669",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "web": "expo start --web",
    "web:https": "npx concurrently \"expo start --web\" \"npx local-ssl-proxy --source 443 --target 8081 --cert localhost.pem --key localhost-key.pem\"",
    "lint": "expo lint",
    "gen:icon-nodes": "node scripts/generate-icon-nodes.mjs",
    "ts-check": "node scripts/ui/cli.mjs pointers --check && node scripts/check-icon-imports.mjs && node scripts/check-haptics-imports.mjs && node scripts/check-no-rn-animated.mjs && node scripts/check-hermes-builtins.mjs && node scripts/check-date-locale.mjs && node scripts/check-event-label-coverage.mjs && node scripts/check-cap-query-names.mjs && node scripts/check-types-client-imports.mjs && node scripts/check-kind-palette.mjs && node scripts/check-user-facing-decision-ids.mjs && node scripts/check-metro-roots.mjs && node scripts/check-worklet-calls.mjs && node scripts/check-tree-private-data.mjs && node scripts/check-no-third-party-products.mjs && node node_modules/typescript-7/bin/tsc --noEmit --checkers 1",
    "verify:push": "bash scripts/ci/verify-push.sh",
    "ui:find": "node scripts/ui/cli.mjs find",
    "ui:show": "node scripts/ui/cli.mjs show",
    "ui:tokens": "node scripts/ui/cli.mjs tokens",
    "ui:check": "node scripts/ui/cli.mjs check",
    "ui:catalogue": "node scripts/ui/cli.mjs catalogue",
    "ui:pointers": "node scripts/ui/cli.mjs pointers",
    "postinstall": "patch-package",
    "update": "eas update --environment production --channel production",
    "update:patch": "node scripts/update.js patch",
    "update:minor": "node scripts/update.js minor",
    "update:major": "node scripts/update.js major",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "submit:all": "eas submit --platform all --latest",
    "release:ios:patch": "node scripts/release-ios.js patch",
    "release:ios:minor": "node scripts/release-ios.js minor",
    "release:ios:major": "node scripts/release-ios.js major",
    "release:android:patch": "node scripts/release-android.js patch",
    "release:android:minor": "node scripts/release-android.js minor",
    "release:android:major": "node scripts/release-android.js major",
    "export:web": "npm run sync:embed && node scripts/write-manifest-for-build.js && npx expo export --platform web --output-dir dist",
    "build:web": "npm run sync:embed && node scripts/write-manifest-for-build.js && npx expo export --platform web --output-dir dist",
    "build:web:embedded": "EXPO_PUBLIC_EMBEDDED=1 node scripts/write-manifest-for-build.js && EXPO_PUBLIC_EMBEDDED=1 COPY_TO_EXTERNAL_HUB=1 npx expo export --platform web --output-dir dist && COPY_TO_EXTERNAL_HUB=1 node scripts/copy-to-external-hub.js",
    "build:ha-addon": "EXPO_PUBLIC_WEB_BASE_PATH=/api/hassio_ingress/camstack npm run build:web && node scripts/copy-dist-to-ha-addon.js",
    "build:orchestrator": "EXPO_PUBLIC_WEB_BASE_PATH=/viewer npm run build:web && node scripts/copy-dist-to-orchestrator.js",
    "build:web:all-targets": "npm run build:web:embedded && npm run build:ha-addon",
    "regen:icons": "node scripts/regen-icons.js",
    "test:nvr-videoclips": "node scripts/test-nvr-videoclips.mjs",
    "test:events-app-api": "node scripts/test-events-app-api.mjs",
    "test:nvr-api": "node scripts/test-nvr-api.mjs",
    "test:reel-benchmark": "node scripts/test-reel-benchmark.mjs",
    "test:v2": "vitest run",
    "test:embed": "vitest run --config embed/vitest.config.ts",
    "build:embed:web": "vite build --config embed/vite.config.ts",
    "build:embed:ota": "vite build --config embed/vite.ota.config.ts",
    "sync:embed": "npm run build:embed:web && npm run build:embed:ota && node scripts/sync-embed-assets.mjs",
    "check:icons": "node scripts/check-icon-imports.mjs",
    "check:haptics": "node scripts/check-haptics-imports.mjs",
    "check:hermes": "node scripts/check-hermes-builtins.mjs",
    "check:event-labels": "node scripts/check-event-label-coverage.mjs",
    "check:types-client": "node scripts/check-types-client-imports.mjs"
  },
  "dependencies": {
    "@camstack/sdk": "^1.2.153",
    "@camstack/types": "^1.2.424",
    "@camstack/ui-library": "^1.2.289",
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "buffer": "^6.0.3",
    "camstack-device-key": "file:./modules/camstack-device-key",
    "camstack-webrtc-audio": "file:./modules/camstack-webrtc-audio",
    "date-fns": "^4.4.0",
    "events": "^3.3.0",
    "expo": "~57.0.31",
    "expo-battery": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-modules-core": "~57.0.24",
    "expo-pip": "2.0.1",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "i18next": "^25.10.10",
    "konva": "^10.3.0",
    "lucide-react": "^0.576.0",
    "lucide-react-native": "^1.24.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-grid-layout": "^2.2.3",
    "react-i18next": "^16.6.6",
    "react-konva": "^19.2.5",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-video": "^6.19.0",
    "react-native-volume-manager": "^2.0.8",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "readable-stream": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "superjson": "^2.2.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-navigation/routers": "^7.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "@config-plugins/react-native-webrtc": {
      "expo": "$expo"
    }
  },
  "private": true
}
