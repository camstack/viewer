# Build variant: development | preview | production (used by eas build --profile)
APP_VARIANT=development

# Apple / Xcode: override Team ID (optional, default in app.config.ts)
# Find it at: https://developer.apple.com/account/#/membership/
EXPO_APPLE_TEAM_ID=

# Seed DB: default integration instances (optional, for initial setup)
# Copy to .env and fill values. App seeds integration_instances on first run if empty.

# External hub
EXPO_PUBLIC_SEED_SCRYPTED_BASE_URL=https://scrypted.local
EXPO_PUBLIC_SEED_SCRYPTED_USERNAME=admin
EXPO_PUBLIC_SEED_SCRYPTED_PASSWORD=

# Separate NVR
EXPO_PUBLIC_SEED_NVR_BASE_URL_LOCAL=http://192.168.1.10:5000
EXPO_PUBLIC_SEED_NVR_BASE_URL_PUBLIC=
EXPO_PUBLIC_SEED_NVR_USERNAME=
EXPO_PUBLIC_SEED_NVR_PASSWORD=
EXPO_PUBLIC_SEED_NVR_TOKEN=

# Home Assistant
EXPO_PUBLIC_SEED_HA_BASE_URL_LOCAL=http://homeassistant.local:8123
EXPO_PUBLIC_SEED_HA_BASE_URL_PUBLIC=
EXPO_PUBLIC_SEED_HA_TOKEN=
